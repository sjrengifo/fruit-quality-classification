    family-names: "Poveda"
  - given-names: "Samuel José"
    family-names: "Rengifo"
repository-code: "https://github.com/sjrengifo/fruit-quality-classification"
url: "https://fruit-quality-classification-2026.streamlit.app"
license: GPL-2.0-only
date-released: "2026-11-26"
keywords:
  - computer vision
  - fruit quality
  - deep learning
  - CRISP-DM
