# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ─── Entornos virtuales ───────────────────────────────────
.venv/
venv/
env/
.env
.conda/

# ─── Jupyter ──────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

